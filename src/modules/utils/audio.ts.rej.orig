+// MARK: - Tactical Haptic Feedback Engine (1:1 with iOS VesperHapticEngine.swift)
+
+class VesperHapticEngineManager {
+  private hasVibrate(): boolean {
+    return typeof navigator !== 'undefined' && 'vibrate' in navigator && typeof navigator.vibrate === 'function';
+  }
+
+  /// Crisp, rigid feedback for buttons, tabs, and terminal interactions
+  public triggerTacticalClick() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate(15); } catch { /* ignore */ }
+    }
+  }
+
+  /// Light feedback for text typing or scramble animation step
+  public triggerSubtleTick() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate(8); } catch { /* ignore */ }
+    }
+  }
+
+  /// Card draw and node population
+  public triggerCardDrawn() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate(35); } catch { /* ignore */ }
+    }
+  }
+
+  /// Daemon Heartbeat Pulse: Resonant double-thump (Systole / Diastole)
+  public playHeartbeatPulse() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate([40, 70, 30, 50]); } catch { /* ignore */ }
+    }
+  }
+
+  /// Geomagnetic / Contrary Friction Buzz
+  public playFrictionBuzz() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate([15, 20, 15, 20, 15, 20]); } catch { /* ignore */ }
+    }
+  }
+
+  /// Warning / Perceptual Drift / Contrary Element alert
+  public triggerWarning() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate([60, 40, 60]); } catch { /* ignore */ }
+    }
+  }
+
+  /// Error / Kernel Panic / System Restraint alert
+  public triggerError() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate([80, 50, 80, 50, 120]); } catch { /* ignore */ }
+    }
+  }
+
+  /// Success / Synchronization Complete
+  public triggerSuccess() {
+    if (this.hasVibrate()) {
+      try { navigator.vibrate([20, 40, 50]); } catch { /* ignore */ }
+    }
+  }
+}
+
+export const vesperAudio = new VesperSoundEffectsManager();
+export const glitchAudio = vesperAudio;
+export const vesperHaptics = new VesperHapticEngineManager();
+
 
